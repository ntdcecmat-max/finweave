{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "FW-WITNESS-HEAD-001"
    },
    "environmentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recordHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "challengeNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "witnessKeyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "profile",
    "environmentId",
    "sequence",
    "recordHash",
    "challengeNonce",
    "issuedAt",
    "witnessKeyId",
    "signature"
  ]
}
