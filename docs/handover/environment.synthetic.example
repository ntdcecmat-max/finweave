# Proposed backend environment only; not read by current frontend.
FINWEAVE_ENV=local_synthetic
DATA_CLASSIFICATION=synthetic_only
TRUST_PROFILE=conventional_synthetic
API_BIND=127.0.0.1
API_PORT=8080
DATABASE_URL=postgresql://127.0.0.1:5432/finweave_synthetic
AUTH_MODE=synthetic_test_only
COOKIE_SECURE=false
USER_ORIGIN=http://127.0.0.1:4181
ADMIN_ORIGIN=http://127.0.0.1:4183
AI_MODE=scripted_synthetic
PRICE_MODE=synthetic
COLLECTOR_SOURCE_MODE=synthetic_test_packages
EXTERNAL_SPEND_CAP_VND=0
DAILY_REFRESH_TIMEZONE=Asia/Ho_Chi_Minh
DAILY_REFRESH_HOUR=18
MAX_NOTIFICATION_BATCH=50
MAX_NOTIFICATION_BYTES=262144
PREVIEW_TTL_SECONDS=600
LOG_PAYLOADS=false
REAL_DATA_ENABLED=false
# Real deployment auth/provider/signing keys are secret references provisioned later,
# never pasted here or into public VITE variables. DATABASE_URL uses ambient local auth.
