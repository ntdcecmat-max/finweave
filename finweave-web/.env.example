# backend = real HTTP transport. Backend synthetic-local is still synthetic DATA.
VITE_DATA_MODE=backend
VITE_ADMIN_DATA_MODE=backend
# Same-origin /v2 proxy by default. HTTPS deployed origin must be configured server-side.
VITE_API_URL=
VITE_OPS_API_URL=
# Optional Android catalog compatibility: use the actual APK version and SDK, never guessed.
VITE_NATIVE_APP_VERSION=
VITE_ANDROID_API=0
